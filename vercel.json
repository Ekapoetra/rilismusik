{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "services": {
    "web": {
      "root": "frontend",
      "framework": "create-react-app",
      "installCommand": "yarn install --non-interactive",
      "buildCommand": "CI=false yarn build",
      "outputDirectory": "build",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "api": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "vercel_production_app:app",
      "functions": {
        "vercel_production_app.py": {
          "maxDuration": 300,
          "excludeFiles": "{tests/**,scripts/**,uploads/**,**/__pycache__/**}"
        },
        "queue_worker.py": {
          "maxDuration": 800,
          "excludeFiles": "{tests/**,scripts/**,uploads/**,**/__pycache__/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
