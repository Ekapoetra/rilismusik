{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "services": {
    "web": {
      "root": "prototype-rilis-musik",
      "installCommand": "npm ci --ignore-scripts --no-audit --no-fund --omit=dev",
      "buildCommand": "node build-web.cjs",
      "outputDirectory": "web-dist"
    },
    "api": {
      "root": "prototype-rilis-musik",
      "framework": "express",
      "entrypoint": "api/index.js",
      "installCommand": "npm ci --ignore-scripts --no-audit --no-fund --omit=dev",
      "functions": {
        "api/index.js": {
          "maxDuration": 30,
          "excludeFiles": "{prototype-v13.0/**,web-dist/**,qa/**,node_modules/playwright/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
