FROM python:3.12-slim
WORKDIR /app/backend
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ ./
ENV PYTHONUNBUFFERED=1 RILISMUSIK_DEPLOYMENT_MODE=production UPLOAD_DIR=/data/uploads PORT=8000
EXPOSE 8000
STOPSIGNAL SIGTERM
CMD ["python", "scripts/start_production.py"]
